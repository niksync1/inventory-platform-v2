{
  "expo": {
    "name": "inventory-platform-v2",
    "slug": "inventory-platform-v2",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Inventory Platform to scan medicine barcodes.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-notifications"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.ck1gh.inventoryplatformv2",
      "googleServicesFile": "./google-services.json",
      "predictiveBackGestureEnabled": false
    }
  }
}
